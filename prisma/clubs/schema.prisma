// ─── Club Migration ────────────────────────────────────────────────

model ClubMigration {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  clubId    String
  club      Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  shop      String
  status    MigrationStatus @default(PENDING)

  // Progress counts (updated by worker after each phase)
  totalRecords           Int @default(0)
  resolvedCount          Int @default(0)
  membershipCreatedCount Int @default(0)
  paymentResolvedCount   Int @default(0)
  contractCreatedCount   Int @default(0)
  errorCount             Int @default(0)

  // Merchant config choices
  contractStrategy  MigrationContractStrategy @default(EAGER)
  gatewayType       String? // "stripe" | "braintree" | "authorize_net" — only if CSV has gateway tokens
  gracePeriodDays   Int                       @default(0)
  sendWelcomeEmails Boolean                   @default(false)

  // File tracking
  filename String? // original CSV filename for display

  // Worker tracking
  workerJobId String?
  completedAt DateTime?
  error       String?

  records ClubMigrationRecord[]

  @@index([clubId])
  @@index([shop])
}

model ClubMigrationRecord {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  migrationId String
  migration   ClubMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)

  // Source data from CSV
  rowNumber               Int
  email                   String
  firstName               String?
  lastName                String?
  phone                   String?
  csvShopifyCustomerId    String?
  externalMemberNumber    String?
  joinedAt                DateTime?
  address1                String?
  address2                String?
  city                    String?
  provinceCode            String?
  countryCode             String?
  zip                     String?
  preferredDeliveryMethod DeliveryMethod?
  notes                   String?
  dateOfBirth             String? // AES-encrypted DOB (PII)
  gatewayCustomerToken    String?
  gatewayPaymentToken     String?

  // ─── Bundle migration fields (bundle-subscription clubs only) ──────
  // See documentation/bundle-subscriptions/migration.md.
  /// Customer's per-line selections from the CSV: [{variantId, quantity, price}].
  /// Required (or `shopifyContractId`) for bundle-club rows.
  bundleSelections  Json?
  /// Customer's billing cadence. Validated against Club.bundleFrequencies at upload.
  bundleFrequency   BundleFrequency?
  /// Optional source contract GID. Must be owned by our app — cross-app
  /// reads are blocked by Shopify's read_own_subscription_contracts scope.
  /// When provided, the worker hydrates lines/discounts/delivery from the
  /// contract instead of reading the CSV columns.
  shopifyContractId String?
  /// Honors the customer's existing next-bill date if provided. Falls back
  /// to today + grace period.
  nextBillingDate   DateTime?

  // Product discount (used for the MIGRATED-fallback path; ignored when
  // matched to a real BundleType — merchant tier wins there)
  productDiscountName  String?
  productDiscountType  DiscountValueType? // PERCENT | FIXED
  productDiscountValue Float?

  // Locked-in shipping (SHIPPING method only)
  shippingRateCode  String?
  shippingBasePrice Float? // pre-discount carrier rate
  shippingPrice     Float? // post-discount price billed (derived from base − discount when discount columns present)

  // Shipping discount (FREE normalized to PERCENT 100 at validation time)
  shippingDiscountName  String?
  shippingDiscountType  DiscountValueType?
  shippingDiscountValue Float?

  // Resolution state (populated by worker phases)
  status                  MigrationRecordStatus @default(PENDING)
  platformCustomerId      String?
  customerResolution      CustomerResolution?
  clubCustomerId          String?
  membershipId            String?
  platformPaymentMethodId String?
  platformContractId      String?
  /// Set by Phase 5 to the BundleType GID that this row was matched to
  /// (or the per-club catch-all MIGRATED type's GID). Drives the
  /// dashboard's "matched vs migrated as-is" categorization.
  bundleTypeIdResolved    String?

  // Status flags
  paymentMethodExists   Boolean   @default(false)
  checkoutLinkSent      Boolean   @default(false)
  checkoutLinkSentAt    DateTime?
  checkoutLinkSendCount Int       @default(0)
  checkoutLink          String?
  migrationCode         String? // unique per-record UUID used to validate migration checkout links
  contractCreated       Boolean   @default(false)
  welcomeEmailSent      Boolean   @default(false)

  // Error tracking
  error      String?
  errorPhase String? // "validation" | "customer_resolve" | "membership_create" | "payment_resolve" | "contract_create"

  @@unique([migrationId, email])
  @@index([migrationId])
  @@index([migrationId, status])
  @@index([platformCustomerId])
  @@index([migrationCode])
}

enum MigrationStatus {
  PENDING
  VALIDATING
  RESOLVING_CUSTOMERS
  CREATING_MEMBERSHIPS
  RESOLVING_PAYMENTS
  COLLECTING_PAYMENTS
  COMPLETED
  FAILED
  CANCELLED
}

enum MigrationContractStrategy {
  EAGER // Create contracts even without payment method
  WAIT_FOR_PAYMENT // Only create when payment method exists
}

enum MigrationRecordStatus {
  PENDING
  CUSTOMER_RESOLVED
  MEMBERSHIP_CREATED
  PAYMENT_RESOLVED
  COMPLETED
  ERROR
  SKIPPED // existing membership found
}

enum CustomerResolution {
  EXISTING_BY_ID // found by shopify_customer_id from CSV
  EXISTING_BY_EMAIL // found via customerByIdentifier
  CREATED // new customer created via customerCreate
}

// ─── GDPR ───────────────────────────────────────────────────────────

model GDPRRequest {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  shop               String
  merchantId         Int
  merchant           Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  type               String // "customer-redact", "customer-data-request", "shop-redact"
  platformCustomerId String?
  clubCustomerId     String?
  instructions       String?
  completed          Boolean   @default(false)
  completedAt        DateTime?

  @@index([shop])
  @@index([type, completed])
}

