generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma/clubs"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id                    Int                    @id @default(autoincrement())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  shop                  String                 @unique
  status                Status
  // Set true when the worker detects this merchant's offline refresh-token
  // chain is dead (re-auth required). Cleared by the app on next successful
  // authenticate.admin(). See documentation/plans/expiring-offline-tokens.md (§4.5).
  needsReauth           Boolean                @default(false)
  //
  // ─── Shopify shop profile ─────────────────────────────────────────────────
  // Mirrored from the shop's Shopify record. Written at install, refreshed by
  // the `shop/update` webhook and the daily merchant-sync CRON. Treat as
  // analytics + sensible defaults — do NOT gate business logic on these, with
  // the deliberate exception of `platformEmail` (see below).
  // Full write-up: documentation/reference/platform/merchant-data-sync.md
  //
  /// Store contact email. NOT purely analytics: this is the To: address for
  /// every merchant email we send, and the fallback support address stamped on
  /// customer-facing emails. Staleness here silently black-holes alerts.
  platformEmail         String?
  platformShopId        String? // Shopify shop ID (degidified, e.g., "12345"); needed for Partner API activeSubscription
  platformShopName      String? // without the .myshopify.com
  /// Shopify `timezoneAbbreviation` ("PDT"). DST-dependent, so it goes stale
  /// twice a year on its own — display only. Use `platformIanaTimezone`.
  platformTimezone      String?
  /// Shopify `ianaTimezone` ("America/Los_Angeles"). The authoritative one, and
  /// what seeds a new club's timezone picker.
  platformIanaTimezone  String?
  platformZipCode       String?
  platformStateCode     String?
  platformProvince      String?
  platformCity          String?
  platformCountryCode   String?
  platformPhone         String?
  platformCurrencyCode  String?
  platformPlanName      String? // Shopify plan, e.g. "Shopify Plus", "Advanced"
  platformDomain        String? // primary storefront host, e.g. "shop.example.com"
  isShopifyPlus         Boolean                @default(false)
  /// Our app subscription as Shopify sees it. The AppBillingPlan FK records
  /// which plan they picked; these record whether that subscription is still
  /// live (ACTIVE / CANCELLED / FROZEN / …), which the FK alone cannot tell us.
  platformBillingId     String?
  platformBillingStatus String?
  /// Last successful profile sync. Also the sync CRON's cursor — it selects the
  /// least-recently-synced merchants, so progress survives a Redis flush or a
  /// container swap mid-run. Null = never synced.
  syncedAt              DateTime?
  /// Set to jump the queue on the next sync tick (support tooling / manual
  /// refresh). Cleared by the sync itself.
  syncForceUpdate       Boolean                @default(false)
  //
  // ─── Install lifecycle ────────────────────────────────────────────────────
  // `status` only ever holds the CURRENT state, so without these a churned or
  // recovered merchant is indistinguishable from one who never left.
  installedAt           DateTime?
  uninstalledAt         DateTime?
  reinstallCount        Int                    @default(0)
  ApiAccess             ApiAccess[]
  GDPR                  GDPR[]
  AppBillingPlan        AppBillingPlan?        @relation(fields: [appBillingPlanId], references: [id])
  appBillingPlanId      Int?
  Club                  Club[]
  MerchantEmailSettings MerchantEmailSettings?
  GDPRRequest           GDPRRequest[]
  UsageBillingRecord    UsageBillingRecord[]
  bundleDiscountId      String? // Shopify automatic discount GID for bundle Function
  bundleCartTransformId String? // Shopify CartTransform ID for bundle Function

  @@index([shop])
}

enum PerUseType {
  transaction
}

enum PerUseUnits {
  percent
  fixed
}

model AdminUser {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lastLogin  DateTime?
  email      String        @unique
  givenName  String
  familyName String
  password   String
  role       Role          @default(USER)
  actions    AdminAction[]
}

enum Role {
  VIEWER
  USER
  ADMIN
  SUPERADMIN
  DISABLED
}

model AdminAction {
  id          String    @id @default(cuid())
  timestamp   DateTime  @default(now())
  user        AdminUser @relation(fields: [userId], references: [id])
  userId      String
  description String
  data        Json?
  notes       String?
}

model ApiAccess {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  privateKey String
  sandboxKey String?  @unique
  limit      Int      @default(60) // 60 requests per minute
  scopes     String[] @default([]) // eg read:products, write:products etc
  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([privateKey, merchantId])
}

model GDPR {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  platform           String    @default("shopify")
  shop               String
  merchantId         Int
  platformCustomerId String?
  customerId         Int?
  completedAt        DateTime?
  completed          Boolean   @default(false)
  type               String // customer redact, customer data request etc
  instructions       String?
  merchant           Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

// Club models go here
model AppSession {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  // Expiring offline access tokens (Shopify deprecation): refresh-token rotation.
  // Null for legacy non-expiring tokens. See documentation/plans/expiring-offline-tokens.md
  refreshToken        String?
  refreshTokenExpires DateTime?
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
}

model AppBillingPlan {
  id              Int         @id @default(autoincrement())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now())
  platform        String      @default("shopify")
  handle          String?     @unique // Shopify App Pricing plan handle; matches ?plan_handle= from welcome redirect
  name            String
  description     String?
  trialDays       Int         @default(0)
  notes           String?
  type            BillingType
  currencyCode    String      @default("USD")
  price           Float       @default(0) // base price
  perUsePrice     Float       @default(0) // eg revenue sharing
  perUseThreshold Float       @default(0) // eg revenue sharing when threshod has been met
  perUseCap       Int         @default(0) // eg revenue sharing capped amount
  perUseUnits     PerUseUnits @default(percent)
  perUseTerms     String      @default("X % per month over Y USD. Capped at Z USD")
  perUseType      PerUseType  @default(transaction)
  merchants       Merchant[]
}

model Club {
  id                                String               @id @default(cuid())
  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime             @updatedAt
  name                              String
  description                       String?
  timezone                          ClubTz               @default(America_New_York)
  platformHandle                    String?
  archived                          Boolean              @default(false)
  status                            ClubStatus           @default(draft)
  platformProductId                 String?
  platformVariantId                 String?
  platformSellingPlanId             String?
  platformClubLocationId            String? // the inventory source location for this club — defaults to primary fulfillment location if null
  platformCustomerTag               String?              @default("club_member") // tag to add to customers who are members of this club
  platformOrderTag                  String?
  membershipPrice                   Float                @default(0) // recurring membership fee amount (mirrors Shopify variant price)
  membershipRenewalFrequency        Int                  @default(12) // in months, eg 3 means every 3 months, default is yearly
  estimatedReleaseFrequency         Int                  @default(4)
  estimatedReleaseUnit              TimeUnit             @default(month)
  releaseType                       ReleaseType          @default(automatic)
  clubType                          ClubType             @default(release) // release or bundle subscription
  bundleFrequencies                 BundleFrequency[]    @default([]) // frequencies offered for bundle subscription clubs (empty for release clubs)
  defaultInventoryAllocationPeriod  Int                  @default(3) // in days, when a release is created, how many days before should inventory be allocated to hold
  defaultCustomerSignupCutoffPeriod Int                  @default(7) // in days, how many days before a release should customers be allowed to sign up
  allowSkipRelease                  Boolean              @default(true)
  addComplianceProducts             Boolean              @default(false) // if true, compliance products will be added to the release orders automatically - requires connection to CrushSuite compliance app
  billingInventoryPolicy            String               @default("PRODUCT_VARIANT_INVENTORY_POLICY") // "PRODUCT_VARIANT_INVENTORY_POLICY" | "ALLOW_OVERSELLING"
  currencyCode                      String               @default("USD")
  market                            String               @default("US")
  nextMemberNumber                  Int                  @default(0) // atomic counter for generating sequential member numbers
  merchantId                        Int
  merchant                          Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Release                           Release[]
  Membership                        Membership[]
  ClubMigration                     ClubMigration[]
  BundleType                        BundleType[]
  UsageBillingRecord                UsageBillingRecord[]
}

enum ClubType {
  release
  bundle_subscription
}

enum ReleaseType {
  automatic
  manual
}

enum TimeUnit {
  day
  week
  month
  year
}

enum ClubStatus {
  draft
  published
  archived
}

model Release {
  id                                String                        @id @default(cuid())
  createdAt                         DateTime                      @default(now())
  updatedAt                         DateTime                      @updatedAt
  name                              String
  platformHandle                    String
  description                       String
  status                            ReleaseStatus                 @default(published)
  archivedAt                        DateTime?
  allowCustomization                Boolean                       @default(true)
  publishDate                       DateTime // when customers can start customizing
  customizationDeadline             DateTime // customers can no longer customize after this date
  signupDeadline                    DateTime? // when customers who sign up for a club can no longer join for this release
  inventoryAllocationDate           DateTime // when inventory should be allocated for this release
  shippingHoldDate                  DateTime? // when shipping should be held until - only relevant for CrushSuite compliance integration. we can decorate all contract orders with this data
  inventoryReserved                 Boolean                       @default(false)
  inventoryReservedAt               DateTime? // when the allocation-date term was first applied (paired with inventoryReserved)
  inventoryUnreserved               Boolean                       @default(false) // tracks pre-billing unreserve completion
  inventoryUnreservedAt             DateTime? // when the pre-billing/archival unreserve completed (paired with inventoryUnreserved)
  inventoryError                    String? // surfaced to merchant when unreserve fails and billing proceeds with ALLOW_OVERSELLING
  releaseOrdersProcessLockId        String? // to prevent concurrent processing of release orders
  billingAttemptsProcessLockId      String? // to prevent concurrent processing of billing attempts
  /**
   * Held while `reconcileReleaseInventory` runs. Two customisations landing together must not
   * both compute the same shortfall and both move it. Same `{uuid}::{timestamp}` shape as the
   * other two, so it ages out on its own — see `~/util/processLock`.
   */
  inventoryReconcileLockId          String?
  allReleaseOrdersCreated           Boolean                       @default(false) // set to true when all release orders have been created for this release
  allReleaseOrdersCreatedAt         DateTime? // when the release orders were created
  // Failure history for bulk release order creation. The CRON re-selects any release with
  // allReleaseOrdersCreated=false every 3h until releaseDate; these back that retry off
  // progressively (see releaseOrderRetryDelayMs) and make "how long has this been failing?"
  // answerable from the DB. Reset to 0/null on success and on merchant reprocess.
  // Deliberately NOT read by the stuck-release monitor — backing off must never mute alerts.
  releaseOrdersAttemptCount         Int                           @default(0) // consecutive failed bulk-create attempts
  releaseOrdersLastAttemptAt        DateTime? // when the last failed attempt finished (null = never attempted)
  releaseOrdersLastError            String? // last failure message, truncated to 500 chars at write
  contractsGenerated                Boolean                       @default(false) // if the contracts have been generated for this release
  contractsGeneratedAt              DateTime? // when the contracts were generated for this release
  // Failure history for contract generation, mirroring the releaseOrders* trio above.
  // Incremented ONLY when the handler's catch fires — never for a healthy run that
  // simply has more batches to do (100 orders/tick), or the release would be backed
  // off mid-generation and could miss its release date. See stuck-releases-risks.md §2.3.
  contractsAttemptCount             Int                           @default(0) // consecutive failed contract-generation attempts
  contractsLastAttemptAt            DateTime? // when the last failed attempt finished (null = never failed)
  contractsLastError                String? // last failure message, truncated to 500 chars at write
  contractBulkOperationId           String? // Shopify bulk op GID for in-flight contract creates; reconcile before next batch
  attemptedFirstBillingAt           DateTime? // when we first attempted to bill customers for this release for all release orders
  releaseDate                       DateTime // when the orders should be created
  // REDUNDANT: today holds a copy of ...Name (a delivery-profile method NAME), NOT a real
  // Shopify method-definition id — the form writes the same value to both. Nothing reads it
  // meaningfully. Revisit if we ever need the true methodDefinition GID.
  defaultPlatformShippingMethodId   String?
  // Merchant-chosen DEFAULT shipping method as a delivery-profile method NAME (e.g. "Standard",
  // "Express", "Economy") — NOT a carrier rate code. Config value + seed for the requested rate at
  // order time; matched against a resolved rate's TITLE (with code as fallback). Carrier-source
  // methods like "Vinoshipper" cannot be pinned this way — see the doc.
  // See documentation/reference/releases/shipping-rate-identity.md
  defaultPlatformShippingMethodName String?
  deliveryMethods                   DeliveryMethod[]              @default([SHIPPING])
  // Allowed shipping method NAMES (same delivery-profile name-space as
  // defaultPlatformShippingMethodName, e.g. "Standard"). Used as a match filter for a member's
  // preferred rate. See documentation/reference/releases/shipping-rate-identity.md
  enabledShippingMethods            String[]                      @default([])
  // Decoupled, FINAL flat shipping PRICE for the release. When set, it overrides the
  // calculated cost on ANY resolved SHIPPING order (not tied to the default method) and
  // shipping discounts do NOT further reduce it. Still needs a rate to resolve (for the
  // contract's shippingOption code/title); SHIPPING-only; 0 = free shipping. Applied via
  // resolveShippingCharge. See documentation/reference/releases/shipping-rate-identity.md
  shippingFlatRate                  Float?
  allowUPSAccessPointPickup         Boolean                       @default(false) // only available to merchant who have CrushSuite compliance integration. This gets registered as a shipping method on the order
  onlyCheapestShippingRate          Boolean                       @default(true) // when true, only the cheapest non-AP shipping rate is shown to customers (plus AP rates if allowed)
  minOrderQuantity                  Int                           @default(1)
  minOrderValue                     Float?
  maxOrderQuantity                  Int?
  giftNote                          String?
  clubId                            String
  club                              Club                          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  ReleaseProduct                    ReleaseProduct[]
  ReleaseOrder                      ReleaseOrder[]
  ReleaseInventoryReservation       ReleaseInventoryReservation[]
  ReleaseInventoryAdjustment        ReleaseInventoryAdjustment[]
  releaseDiscounts                  ReleaseDiscount[]
  ReleaseReprocessLog               ReleaseReprocessLog[]

  @@index([clubId])
  @@index([clubId, releaseDate])
}

enum ReleaseStatus {
  draft
  published
  archived
}

model ReleaseProduct {
  id                          String                        @id @default(cuid())
  createdAt                   DateTime                      @default(now())
  release                     Release                       @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId                   String
  platformProductId           String
  platformVariantId           String
  quantity                    Int
  maxQuantity                 Int?
  minQuantity                 Int? // this essentially means the product is required to be purchased
  quantityAdjustable          Boolean                       @default(true)
  priceAtCreation             Float                         @default(0) // price at the time of release creation, used for compareAt price
  price                       Float                         @default(0) // the merchant sets this price in the admin, they can use this instead of a discount
  currencyCode                String                        @default("USD")
  excludeFromDiscounts        Boolean                       @default(false)
  kind                        ProductKind
  orderPriority               Int                           @default(0) // lower numbers appear first
  ReleaseOrderProduct         ReleaseOrderProduct[]
  ReleaseInventoryReservation ReleaseInventoryReservation[]

  releaseProductBundle   ReleaseProductBundle? @relation(fields: [releaseProductBundleId], references: [id])
  releaseProductBundleId String?

  @@index([releaseId])
}

enum ProductKind {
  optional
  default
}

model ReleaseProductBundle {
  id                   String           @id @default(cuid())
  name                 String
  description          String?
  platformCollectionId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  ReleaseProduct       ReleaseProduct[]
}

// Discounting models are designed to be polymorphic and reusable across different systems in the Clubs app
model ReleaseDiscount {
  id        String  @id @default(cuid())
  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  name        String
  description String?

  scope       DiscountScope // PRODUCT | SHIPPING
  condition   DiscountCondition // QUANTITY | SUBTOTAL - quantity overules subtotal - we should prevent having both in the UI
  minQuantity Int?
  minSubtotal Float?

  valueType       DiscountValueType // PERCENT | FIXED
  discountPercent Float?
  discountAmount  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([releaseId])
}

enum DiscountScope {
  PRODUCT
  SHIPPING
}

enum DiscountCondition {
  QUANTITY
  SUBTOTAL
}

enum DiscountValueType {
  PERCENT
  FIXED
}

model ReleaseInventoryReservation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  releaseProductId String
  releaseProduct   ReleaseProduct @relation(fields: [releaseProductId], references: [id], onDelete: Cascade)

  platformLocationId      String // degidified Shopify Location ID
  platformInventoryItemId String // degidified Shopify InventoryItem ID

  quantityReserved   Int @default(0) // total units in "reserved" state
  quantityUnreserved Int @default(0) // units moved back to "available" pre-billing
  /**
   * What the rule said we should hold, last time the reconcile ran: every member's chosen
   * quantity, plus a default box for each untouched member once the allocation date has
   * passed. `quantityReserved` is what we actually hold; the gap between them is `deficit`.
   * 0 on a row the reconcile has never visited — the dashboard reads that as "not yet
   * reconciled", not "nothing required".
   */
  requiredQuantity   Int @default(0)
  /**
   * Current shortfall — `requiredQuantity − quantityReserved`, floored at 0 — **set** on every
   * reconcile, not accumulated. It used to increment per reserve attempt, which turned a wine
   * that was short once into one that looked shorter every time anyone customised it.
   */
  deficit            Int @default(0)

  reservedAt   DateTime? // when reserve completed
  unreservedAt DateTime? // when unreserve completed

  reserveReferenceUri   String? // Shopify referenceDocumentUri for audit trail
  unreserveReferenceUri String? // referenceDocumentUri for the unreserve

  @@unique([releaseId, releaseProductId]) // one record per product per release
  @@index([releaseId])
}

enum InventoryAdjustmentDirection {
  reserve
  unreserve
}

/**
 * One row per inventory move we make in Shopify for a release — append-only.
 * `ReleaseInventoryReservation` is the ledger: one number per wine, what we hold now. This is
 * the audit behind it. Every `inventoryMoveQuantities` returns an `InventoryAdjustmentGroup`,
 * and that object implements `Node`, so any move can be read back from Shopify by its id —
 * state, signed delta, and our ledger URI. Summing the reserved deltas across a release's
 * rows is what we hold, by Shopify's own record, independent of our database.
 * That is what makes a lost write recoverable. We cannot ask Shopify what is reserved under our
 * ledger URI (no query filters by it), so without these ids a hold whose ledger write failed
 * would sit in `reserved` with nothing to return it. With them, deallocation can compare the
 * ledger to Shopify's own account of our moves and return the larger.
 * `releaseProductId` is a plain column, deliberately not a relation: a merchant editing the
 * release's products cascade-deletes `ReleaseProduct`, and the audit has to outlive that. Rows
 * are removed only when the release itself is.
 */
model ReleaseInventoryAdjustment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  releaseProductId String

  platformInventoryItemId   String // degidified Shopify InventoryItem ID
  platformLocationId        String // degidified Shopify Location ID
  platformAdjustmentGroupId String? // degidified Shopify InventoryAdjustmentGroup ID; null = the move was inferred from stock figures after a lost response, never confirmed by Shopify

  direction InventoryAdjustmentDirection
  quantity  Int // always positive; `direction` carries the sign

  @@index([releaseId])
}

// Does not represent a completed order necessarily, just all the products a customer has made for a release
// used for generation of contracts in Shopify
model ReleaseOrder {
  id                                String                         @id @default(cuid())
  createdAt                         DateTime                       @default(now())
  updatedAt                         DateTime                       @updatedAt
  releaseId                         String
  release                           Release                        @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  customizedAt                      DateTime? // when the customer last customized this order
  platformCustomerId                String
  platformContractId                String? // eg the subscription contract ID in Shopify
  contractGeneratedAt               DateTime?
  contractCreateAttemptedAt         DateTime? // set before create so recovery search only runs on retries
  /// Shopify confirmed the contract in `platformContractId` is CANCELLED, and
  /// this is when. Written only on close-out, which **keeps** the reference.
  ///
  /// A recorded fact rather than an inference. The skip and rebuild paths null
  /// the reference instead, and for them that is right — both expect the order
  /// to be contracted again, so "no reference" means "contract me". Close-out
  /// expects nothing further, so nulling bought an invariant and cost the only
  /// handle we hold on the contract: a 3DS charge completed weeks after the
  /// write-off arrives as a `subscription_billing_attempts/success` webhook
  /// keyed on the contract id, and with the column nulled nothing could match
  /// it to an order. A member was charged and no row anywhere said so.
  ///
  /// So a live contract is `platformContractId` set **and this null** — not
  /// `platformContractId` set. Both CRON selectors gate on `closedOutAt: null`
  /// rather than on the reference, so keeping it bills nothing.
  contractCancelledAt               DateTime?
  attemptedFirstBillingAt           DateTime? // we only auto bill once per release order, so record when we first attempted to bill
  orderCreatedAt                    DateTime? // when the order was created in the platform
  platformOrderId                   String? // if the order has been created in Shopify
  products                          ReleaseOrderProduct[]
  skippedAt                         DateTime? // if the customer skipped this release, when did they skip. Note this means other data, like the platform contract id should be empty
  /// The merchant wrote this order off: it will never ship and never bill.
  ///
  /// Deliberately **not** `skippedAt`. That column records a *customer*
  /// decision — it shows the member a "Skipped" badge in their own order
  /// history, writes "Member skipped release" on their timeline, and feeds
  /// `getSkipRateForShop`, which drives the Home Skip-rate KPI and the club
  /// health snapshot. Those are member-disengagement metrics; a merchant
  /// write-off moving them is a lie about why the member did not receive wine.
  ///
  /// This is the only terminal state a merchant can author, and the only one
  /// that is not derivable from what Shopify holds — hence a stored decision
  /// rather than another status. See
  /// `documentation/reference/releases/release-order-lifecycle-actions.md`.
  closedOutAt                       DateTime?
  /// Who closed it out (email / user id), for the audit trail.
  closedOutBy                       String?
  /// Why. Required by the action — a silent write-off is what this replaces.
  closedOutReason                   String?
  deliveryPrice                     Float                          @default(0)
  deliveryMethod                    DeliveryMethod                 @default(SHIPPING)
  deliveryAddress                   Json?
  deliveryPhone                     String? // phone number for delivery notifications
  // Pickup specific fields
  deliveryPickupPlatformLocationId  String? // if pickup, which location ID
  deliveryPickupTitle               String? // eg the title of the pickup location
  deliveryPickupDescription         String? // eg the description of the pickup location, eg address etc
  deliveryPickupCode                String? // eg the pickup code for Store pickups
  // Local delivery specific fields
  deliveryLocalDeliveryCode         String? // eg the code to identify the local delivery
  deliveryLocalDeliveryInstructions String? // special instructions for local delivery
  // Shipping specific fields
  // Resolved rate CODE (e.g. "03:U61302558") → subscription contract shippingOption.code.
  // Contract-critical, not display. Historically has also held rate TITLES/method NAMES (the
  // requested value is preserved before the resolved code), so legacy rows are mixed. For PICKUP
  // this column is reused to store the pickup location title. See documentation/reference/releases/shipping-rate-identity.md
  shippingRate                      String?
  // Resolved rate TITLE (e.g. "UPS Ground") → subscription contract shippingOption.title.
  // Display + contract-critical (Shopify requires it non-blank). See documentation/reference/releases/shipping-rate-identity.md
  shippingRateTitle                 String?
  platformPaymentMethodId           String? // eg the payment method ID in Shopify
  complianceFee                     Json? // compliance fee object {[variantId: number]: quantity}
  complianceFeeCost                 Float                          @default(0)
  complianceCheckValid              Boolean?
  discountAmount                    Float                          @default(0)
  discountPercent                   Float                          @default(0)
  shippingDiscountAmount            Float                          @default(0)
  shippingDiscountPercent           Float                          @default(0)
  subtotal                          Float                          @default(0)
  customerShippingHoldUntil         DateTime? // if the customer has requested a shipping hold until date
  customerNotes                     String?
  total                             Float                          @default(0)
  currencyCode                      String                         @default("USD")
  preProcessingError                Boolean                        @default(false) // if there is likely to be a processing error due to data issues
  giftNote                          String? // this gets copied from the release at creation time but can be edited here as it is per-order, so can tailor to the customer
  clubCustomerId                    String
  clubCustomer                      ClubCustomer                   @relation(fields: [clubCustomerId], references: [id], onDelete: Cascade)
  orderProcessingRecords            ReleaseOrderProcessingRecord[]
  /**
   * Why this order is blocked, one row per distinct cause. `preProcessingError`
   * records *that* it is blocked; these record *why*. See ReleaseOrderIssue.
   */
  issues                            ReleaseOrderIssue[]
  events                            ReleaseOrderEvent[]
  /// What the shop wrote about this order themselves — see `ReleaseOrderNote`.
  merchantNotes                     ReleaseOrderNote[]
  refunds                           ReleaseOrderRefund[]
  refundedAmount                    Float                          @default(0)
  refundedQuantity                  Int                            @default(0)
  lastRefundedAt                    DateTime?

  @@unique([releaseId, platformCustomerId])
  /// Refund capture resolves the order by this column on every `refunds/create`
  /// webhook, which fires for every refund in the store, not just club orders.
  @@index([platformOrderId])
}

model ReleaseOrderRefund {
  id               String                   @id @default(cuid())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  releaseOrderId   String
  releaseOrder     ReleaseOrder             @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  platformRefundId String                   @unique
  refundedAt       DateTime
  amount           Float                    @default(0)
  currencyCode     String                   @default("USD")
  note             String?
  lines            ReleaseOrderRefundLine[]

  @@index([releaseOrderId])
}

model ReleaseOrderRefundLine {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  refundId           String
  refund             ReleaseOrderRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  platformLineItemId String
  platformVariantId  String?
  title              String?
  quantity           Int                @default(0)
  amount             Float              @default(0)

  @@index([refundId])
}

enum DeliveryMethod {
  SHIPPING
  PICKUP
  LOCAL_DELIVERY
}

/// What happened to a release order, and who did it.
///
/// The three tables that record trouble on an order answer different questions,
/// and keeping them apart is what makes each one trustworthy:
///
///  - `ReleaseOrderIssue` — what is wrong **now**, and why. Current state.
///  - `ReleaseOrderProcessingRecord` — what Shopify said when we asked it to
///    create a contract or take a charge. One row per attempt.
///  - this — what **happened**, and **who** did it. History, and nothing else.
///
/// **Nothing may read these rows to decide anything.** That rule is the whole
/// design, not a guideline: `ReleaseOrderProcessingRecord` was also "just a
/// log" until readers came to depend on row existence — and row *absence* — as
/// state, until `orderProcessingRecords: { none: {} }` became the literal
/// definition of "billing went quiet". Once absence means something, every new
/// writer is a potential behaviour change.
///
/// So there is deliberately **no column a decision could key on**: no status,
/// no `success`, no `resolvedAt`, no counters, nothing countable. Anything a
/// surface actually reads stays a column elsewhere — `skippedAt`,
/// `contractGeneratedAt`, `preProcessingError`. These rows are only ever the
/// story of how those came to be. The day someone wants a badge driven by
/// events they have to add a counting helper, which is a visible diff in review
/// rather than a condition creeping quietly into a predicate.
///
/// Written fire-and-forget, outside the transaction that made the change. These
/// writes are unlikely to fail and adding one to every bulk path would mean
/// touching far more code than the guarantee is worth.
///
/// **There is deliberately no event for a charge succeeding, failing or being
/// retried.** `ReleaseOrderProcessingRecord` already holds every billing
/// attempt and its outcome, and a second copy here would be two records of one
/// fact — the dual-write this split exists to avoid. One timeline on screen,
/// three tables underneath: the merchant-facing timeline reads all three and
/// interleaves them by time, which is a display concern, not a reason to
/// duplicate rows. The one thing genuinely absent is *who* pressed "Retry
/// billing"; the record carries the attempt but no actor.
model ReleaseOrderEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  releaseOrderId String
  releaseOrder   ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)

  type       ReleaseOrderEventType
  /// Who performed this write — never who asked for it.
  ///
  /// A merchant clicking a button that queues a job produces two rows: MERCHANT
  /// dispatched it, SYSTEM did it, joined by `jobId`. That keeps `actor`
  /// meaning one thing at every row, and makes the failure we actually hit
  /// legible — a dispatch that never reached the worker leaves a merchant
  /// action with no system event following it.
  actor      ReleaseOrderEventActor
  /// Reserved, and null on every row.
  ///
  /// The app does not enable online tokens, so `associated_user` is always
  /// undefined and every per-user lookup falls back to the shop domain.
  /// MERCHANT therefore means "someone with dashboard access at this shop", not
  /// a named person, and the merchant-facing copy must not imply otherwise.
  /// This is the seam if online tokens are ever enabled; filling it now would
  /// be inventing data. Same limitation as `ReleaseReprocessLog.triggeredBy`.
  actorLabel String?

  /// The values the merchant-facing sentence is built from — a rate name, the
  /// fields that changed, an amount, which of the six ways an order was made.
  ///
  /// Never a finished sentence. Prose cannot be translated, and the last thing
  /// this codebase stored as prose (`ReleaseOrder.notes`) ended up being
  /// substring-matched by three separate readers.
  data   Json?
  /// Internal only. Raw upstream errors, payload fragments. Never rendered on
  /// the timeline itself.
  detail Json?

  /// The BullMQ job this came from, so a merchant action and the background
  /// work it triggered can be joined.
  jobId String?

  /// The Shopify receipt this event is *about*, where one exists. The event
  /// never restates the record's outcome — the timeline renders the record.
  processingRecordId String?
  processingRecord   ReleaseOrderProcessingRecord? @relation(fields: [processingRecordId], references: [id], onDelete: SetNull)

  @@index([releaseOrderId, createdAt])
}

enum ReleaseOrderEventActor {
  /// The member — Customer Accounts, or the storefront.
  CUSTOMER
  /// A dashboard action on an authenticated admin session. Shop-level, not a
  /// named person — see `actorLabel`.
  MERCHANT
  /// Our own automation: CRONs, worker jobs, bulk batches, migration.
  SYSTEM
  /// An inbound webhook. Shopify telling us something happened.
  ///
  /// Split from SYSTEM deliberately: "did we do this, or did Shopify tell us it
  /// happened?" is the question that made several traces ambiguous. A contract
  /// creation is ours; a billing failure is Shopify's statement about a charge.
  SHOPIFY
}

/// What happened. The merchant-facing wording lives in `en.json`, keyed by
/// these — the names here are internal and say "contract" and "release order"
/// freely; the copy never does.
enum ReleaseOrderEventType {
  // --- how the order came to exist -----------------------------------------
  /// `data.source` says which of the six ways: the default-box batch, the
  /// member customizing, the member saving fields, the shop adding them, late
  /// signup processing, or the placeholder written for a paused member.
  ///
  /// A qualifier rather than six types: it is one thing that happened, and a
  /// seventh way to create an order should not need a migration.
  ORDER_CREATED
  CUSTOMIZED

  // --- why it is not shipping ----------------------------------------------
  // Seven distinct events, because `skippedAt` carrying all of them is exactly
  // what tells a member who *left the club* that they "skipped a release".
  // "Skip" appears only where the member actually chose to skip. A pause or a
  // migration is a hold — the order comes back. Leaving is a cancellation — it
  // does not. See #1025 for the column half of this.
  MEMBER_SKIPPED
  MEMBER_UNSKIPPED
  HELD_MEMBERSHIP_PAUSED
  RESUMED_MEMBERSHIP_REACTIVATED
  HELD_MEMBERSHIP_MIGRATING
  CANCELLED_MEMBER_LEFT
  CLOSED_OUT

  // --- what the member changed ---------------------------------------------
  ADDRESS_CHANGED
  PHONE_CHANGED
  PAYMENT_METHOD_CHANGED

  // --- what the shop changed -----------------------------------------------
  DELIVERY_EDITED
  LINE_ITEMS_EDITED
  PAYMENT_METHOD_EDITED
  GIFT_NOTE_EDITED
  CUSTOMER_NOTES_EDITED
  SHIPPING_HOLD_EDITED
  ISSUE_DISMISSED

  // --- what is wrong, and when it stopped being wrong ----------------------
  // The append-only half of `ReleaseOrderIssue`. That table carries one row per
  // cause and **reuses** it when a cause recurs — a fresh `openedAt`, a cleared
  // `resolvedAt`, on the same row — which is right for "what is wrong now" and
  // destroys the previous episode. These two record the transitions so an order
  // held, fixed, and held again reads as three things rather than one.
  //
  // **Transitions only.** `openIssuesTx` deliberately leaves a row that never
  // closed alone, because re-detecting a cause the merchant is already working
  // through is not new information. These events hang off that same condition.
  // Written on every detection instead, `BILLED_ORDER_NOT_FOUND` alone would add
  // a row every thirty minutes forever — `reconcileUnresolvedOrderIds` keeps
  // finding the same order, and opening an advisory cause does not resolve the
  // processing record it selects on.
  //
  // `data` carries `code` and `blocksProcessing` — values for the copy, never a
  // sentence. The merchant-facing name for each code lives with the other
  // vocabulary, in `releaseOrderEventDisplay.ts`.
  //
  // **Still nothing may read these to decide anything.** The order's current
  // state is the issue row; these are its history. In particular they are not
  // countable: the writes are best-effort by design (see the model docstring)
  // and the timeline read is capped, so "how many orders are held" asked here
  // would be wrong where `ReleaseOrderIssue` already answers it correctly.
  ISSUE_OPENED
  ISSUE_RESOLVED

  // --- what we worked out --------------------------------------------------
  // Two values, because `SHIPPING_RESOLVED` was two facts under one name and
  // "resolved" meant the *rate* got settled, not that a problem was fixed.
  //
  // `data` on both carries the payload `captureShippingResolution` already
  // builds: outcome, requested, resolved code/title/source, cost.
  /// We charged a rate other than the one asked for — the cheapest-fallback
  /// branch fired and something had been requested, or a member preference this
  /// release does not offer.
  ///
  /// **Nothing is held**, and an **advisory** `SHIPPING_RATE_SUBSTITUTED` cause is
  /// raised alongside: the order is billable, but the event alone reached no
  /// surface a merchant looks at. This explains a delivery price the merchant did
  /// not expect, which the order row cannot — it keeps what was charged, never
  /// what was requested. It is the *only* shipping event a newly created order can
  /// get, since a new order has no cause to have fixed.
  ///
  /// Not raised when no rate resolved at all: the order is held charging nothing,
  /// so there is no substitution to report.
  ///
  /// Not "backup rate": Shopify's own `backup_rate` prediction is the thing this
  /// codebase refuses, holding the order instead (`carrier_no_quote`).
  SHIPPING_RATE_SUBSTITUTED
  /// The order had no usable shipping rate and now has one — the transition a
  /// merchant waits for after "Recalculate shipping".
  ///
  /// Overlaps `ISSUE_RESOLVED` on the three codes in `SHIPPING_ISSUE_CODES`, and
  /// deliberately is not folded into it: `shippingIsResolved` is the stricter
  /// test — a non-blank rate *and* a title *and* an order that is actually
  /// shipping *and* no new shipping cause raised in the same pass. An order moved
  /// to pickup, or a pass that closes `CARRIER_RATE_UNAVAILABLE` while opening
  /// `MISSING_SHIPPING_RATE`, closes a cause with no rate to show for it. Both
  /// used to report a resolved rate on an order that had none.
  ///
  /// So `ISSUE_RESOLVED` says the cause closed; this says it genuinely worked.
  SHIPPING_RATE_FOUND

  // --- setting up the payment ----------------------------------------------
  /// Written by **every** path that creates a contract — the bulk batch, late
  /// signup, and the merchant's own button. `contractGeneratedAt` records
  /// *when* and stays the column surfaces read; this records *which path and
  /// who*, which the column cannot answer. Covering only the batch would
  /// reproduce the drift #1032 fixed, in a new table.
  CONTRACT_CREATED
  /// The other half of the pair. Without it the timeline shows a payment
  /// scheduled and never that it was called off, which reads as a member still
  /// due to be charged.
  ///
  /// **Only written when Shopify actually accepted the cancel.** Every cancel
  /// site is best-effort and keeps `platformContractId` when Shopify refuses,
  /// precisely so a live contract is not forgotten; claiming here that payment
  /// is off for an order Shopify could still bill would hide that.
  /// `data.reason` says what prompted it — the cause itself is its own event
  /// immediately before this one.
  CONTRACT_CANCELLED
  /// A merchant's edit reached Shopify.
  ///
  /// The dispatch pair records that the sync was *queued*; this records that it
  /// landed, which is a different fact and the one a merchant asking "did my
  /// address change go through?" needs. Without it the answer is the absence of
  /// a `CONTRACT_SYNC_FAILED` cause — inferring success from the lack of a
  /// failure, which is the habit this table exists to break.
  ///
  /// `data.synced` lists what was sent (delivery, attributes, payment method).
  CONTRACT_SYNCED

  // --- what the shop wrote down ---------------------------------------------
  // Three types rather than one with a direction, for the same reason
  // MEMBER_SKIPPED and MEMBER_UNSKIPPED are two: adding a note and taking one
  // away are different facts, and a merchant reading the timeline wants to see
  // which happened without decoding a payload.
  //
  // The note's text is deliberately **not** in `data`. It lives in
  // `ReleaseOrderNote`, where it can be edited and where a redaction request can
  // reach it — copying it here would put an unreachable snapshot of a member's
  // personal data in a table nothing may modify. `data.sendToShopify` records
  // whether it was one of the notes that travels, which is the part that changes
  // what the member's order says.
  MERCHANT_NOTE_ADDED
  MERCHANT_NOTE_EDITED
  MERCHANT_NOTE_REMOVED

  /// A charge landed on an order the shop had written off.
  ///
  /// The event exists because nothing else on the order can say it. The
  /// processing record says Shopify charged the card — which is true and is all
  /// Shopify said — and the `CLOSED_OUT` event says the shop ended the order.
  /// Neither carries the fact that they happened in that order, which is the
  /// whole problem: a member paid for wine nobody is sending.
  ///
  /// `data` carries `platformOrderId` (null when the webhook and its poll never
  /// produced one) and `platformBillingAttemptId`.
  CHARGED_AFTER_CLOSE_OUT

  // --- money going back ----------------------------------------------------
  /// Money returned on an order we already charged. Recorded when the order's
  /// refund totals actually change, so a replayed `refunds/create` webhook is
  /// silent but a corrected amount is not.
  ///
  /// `data` carries figures, never a sentence: this refund's `amount`, the new
  /// cumulative `refundedAmount` and `refundedQuantity`, and `currencyCode`.
  /// The per-refund detail stays in `ReleaseOrderRefund` — this says only that
  /// the order changed and by how much.
  REFUNDED

  // --- whether the background work ran -------------------------------------
  // An order handed to the worker and never processed is otherwise
  // indistinguishable from one that was never handed over. A dispatch that
  // fails writes DISPATCH_FAILED with no `jobId`, so the timeline shows a
  // merchant action with no system event following it.
  WORKER_JOB_DISPATCHED
  WORKER_JOB_DISPATCH_FAILED
}

/// A note the **shop** wrote about one release order.
///
/// The one place on a release order where a person's own words are stored, and
/// the reason `ReleaseOrder.notes` can go: that column mixed machine diagnostics
/// with the only writable space a merchant had. Diagnostics are now events and
/// causes; this is the notepad.
///
/// **Two concepts, one table, told apart by `sendToShopify`.** An internal note
/// never leaves the dashboard. A note with the flag set is concatenated into the
/// subscription contract's `note`, which Shopify applies to the order that
/// billing generates — so it reaches whoever packs the box. One table because the
/// merchant writes both in the same form with a checkbox, and two parallel
/// columns would be two things for the UI to keep in step.
///
/// **A row, not an array entry.** `notes` proved what a bare `String[]` costs:
/// no author, no timestamp, and no handle on any single entry, so "delete the
/// second one" is an index that shifts under a colleague editing at the same
/// time. Several notes coexisting is current state, so it needs rows — the
/// history of who wrote and changed them is in `ReleaseOrderEvent`, and nothing
/// reads those events to work out what the notes currently are.
model ReleaseOrderNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  releaseOrderId String
  releaseOrder   ReleaseOrder @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)

  /// The merchant's words, as typed. Never machine-generated prose — that is
  /// what `notes` was, and why it could not be translated or parsed.
  body String

  /// Whether this note is sent to Shopify, where it lands on the order billing
  /// creates. False is internal-only and is the default, because sending a
  /// member's words onward should be a deliberate tick rather than a surprise.
  ///
  /// It can only travel while the contract is still the thing that drives the
  /// order. After billing, the note is on a real Shopify order and the contract
  /// cannot reach it — so a later edit changes what the dashboard shows and
  /// nothing else, which the UI says plainly.
  sendToShopify Boolean @default(false)

  /// Null everywhere today: the app does not enable online tokens, so no
  /// dashboard action knows which member of staff performed it. Same gap as
  /// `ReleaseOrder.closedOutBy` and `ReleaseOrderEvent.actorLabel`. Here now so
  /// the data is right the day identity is threaded, rather than invented.
  createdBy String?

  /// Removed by the merchant, and kept.
  ///
  /// A note can be the only record of what a member asked for, so a mis-click
  /// must not destroy it and support needs to see what an order was told. Every
  /// merchant-facing read filters `archivedAt: null`; so does the contract push,
  /// which means removing a sent note rewrites the contract without it.
  ///
  /// **Retained, not immortal.** These bodies hold personal data — a name, a
  /// neighbour, a phone number — and `handleCustomerRedact` anonymises the
  /// `ClubCustomer` while deliberately keeping the order. So the redact path
  /// clears note bodies for that member's orders, archived rows included.
  /// Without that, archiving would quietly build a store of personal data
  /// nothing could erase on request.
  archivedAt DateTime?

  /// The merchant-facing read is "this order's live notes", and the contract
  /// push narrows the same set by `sendToShopify`.
  @@index([releaseOrderId, archivedAt])
}

model ReleaseOrderProcessingRecord {
  id                                   String              @id @default(cuid())
  createdAt                            DateTime            @default(now())
  updatedAt                            DateTime            @updatedAt
  releaseOrderId                       String
  releaseOrder                         ReleaseOrder        @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  key                                  String? // unique key for the processing attempt, eg "initial_payment_attempt", "retry_1" etc
  completedAt                          DateTime?
  nextActionUrl                        String? // eg a url to redirect the customer to complete payment - update on webhook
  platformSubscriptionBillingAttemptId String? // if a billing attempt has been made for the subscription. errors can be recorded at contract generation or billing attempt
  platformErrorCode                    String?
  errorData                            Json?
  success                              Boolean             @default(false)
  processingAttempt                    Int                 @default(1) // incremented each time an attempt is made to process the order
  /// Events *about* this receipt. The timeline renders the receipt itself; an
  /// event links to it rather than restating its outcome.
  events                               ReleaseOrderEvent[]
}

/// Why a release order is blocked — the structured counterpart to the bare
/// `ReleaseOrder.preProcessingError` boolean.
///
/// The flag records *that* an order is held and is what both worker selectors
/// gate on. It has never recorded *why*: that lived only in the free-text
/// `notes[]` array, of which the UI rendered at most one line, so the dashboard
/// had to infer a cause by substring-matching English worker prose. Inference
/// also means a new failure mode is invisible until someone remembers to add a
/// clause for it — the root of the visibility gaps in
/// `documentation/reference/releases/release-order-visibility.md`.
///
/// **These rows are now the source of truth, and the flag is their projection.**
/// `preProcessingError` means "this order has an open `blocksProcessing` issue"
/// and is recomputed from these rows on every open/resolve/reconcile, in the
/// same transaction as the write (`projectPreProcessingError`, mirrored in both
/// packages). Nothing sets it by hand.
///
/// That is what fixes #724 by construction rather than by remembering: when a
/// card arrives and `MISSING_PAYMENT_METHOD` closes, an open
/// `INCOMPLETE_SHIPPING_DETAILS` keeps the order held, because no path has to
/// re-validate anything. The flag stays a column because both worker selectors
/// gate on `preProcessingError: false`, and that indexed test is the query shape
/// the automation depends on.
///
/// One row per (order, code): a recurrence reopens the existing row rather than
/// appending. Per-attempt history belongs in `ReleaseOrderProcessingRecord`.
model ReleaseOrderIssue {
  id               String                       @id @default(cuid())
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  releaseOrderId   String
  releaseOrder     ReleaseOrder                 @relation(fields: [releaseOrderId], references: [id], onDelete: Cascade)
  code             ReleaseOrderIssueCode
  /// The specifics behind the code — which fields were missing, the upstream
  /// error message. What `notes[]` was carrying, attached to a cause.
  detail           String?
  /// Whether this cause holds the order out of contract generation and billing.
  /// False for advisory causes that are worth surfacing but do not block.
  blocksProcessing Boolean                      @default(true)
  openedAt         DateTime                     @default(now())
  /// Null while outstanding. Set when the cause is no longer detected.
  resolvedAt       DateTime?
  resolvedBy       ReleaseOrderIssueResolvedBy?

  @@unique([releaseOrderId, code])
  @@index([releaseOrderId, resolvedAt])
}

enum ReleaseOrderIssueCode {
  MISSING_PAYMENT_METHOD
  MISSING_SHIPPING_RATE
  SHIPPING_LOOKUP_FAILED
  /// The live-rate carrier never quoted this address: Shopify answered with only
  /// its own `backup_rate` prediction, which no carrier has a method for, and the
  /// escalation ladder in `getShipping` exhausted its retries and CS Compliance.
  /// Unlike every other shipping cause, nothing about the ORDER is wrong — the
  /// carrier timed out — so the merchant's repair is "recalculate", not "correct
  /// the address". See documentation/reference/releases/shipping-rate-identity.md.
  CARRIER_RATE_UNAVAILABLE
  /// The order is priced on a rate nobody asked for: the requested rate was not
  /// available and the cheapest was charged, or the member's saved rate is not
  /// offered on this release.
  ///
  /// **Advisory** (`blocksProcessing: false`) — the order is billable and holding
  /// it would be worse than the wrong price. It exists so the merchant can *see*
  /// it: before this the only trace was one line on the order's own timeline, and
  /// a member charged a rate the release never configured reached no surface
  /// anybody looks at.
  ///
  /// Not raised for a carrier-source match. "Vinoshipper" is a delivery profile
  /// rather than a rate, so resolving it to the cheapest of that carrier's own
  /// rates is a legitimate match, not a substitution.
  SHIPPING_RATE_SUBSTITUTED
  INCOMPLETE_SHIPPING_DETAILS
  MISSING_PHONE
  MISSING_PICKUP_LOCATION
  DELIVERY_METHOD_UNAVAILABLE
  NO_PRODUCTS
  CUSTOMER_NOT_FOUND
  MEMBERSHIP_NOT_FOUND
  CONTRACT_CREATION_FAILED
  /// A merchant edited the order in the dashboard and the change could not be
  /// pushed to the live Shopify contract — the dashboard and what the member is
  /// actually charged now disagree. Advisory (`blocksProcessing: false`): the
  /// order is still billable, it just bills the pre-edit contract.
  CONTRACT_SYNC_FAILED
  /// Billing succeeded but the resulting Shopify order could never be found —
  /// the webhook carried no `order_id`, its poll gave up, and the reconcile
  /// sweep then looked for a day and found nothing on the contract.
  ///
  /// Advisory (`blocksProcessing: false`): the member was charged, so this must
  /// never re-enter the order into contract generation or billing. It exists to
  /// end the sweep, name the cause on Highlighted Issues, and let the dashboard
  /// offer close-out for a state that otherwise has no action at all.
  /// See `documentation/reference/releases/stuck-releases-risks.md` §5.1.
  BILLED_ORDER_NOT_FOUND
  /// The Compliance app ran its prepurchase check and refused — wrong state for
  /// the product, a minimum-quantity rule, an age-verification failure. Advisory
  /// (`blocksProcessing: false`): the documented rule is that a failed check
  /// does not hold the order, it bills and the errors are surfaced.
  /// A charge completed on an order the merchant had already written off.
  ///
  /// Only reachable one way: a 3DS challenge the member completes after the
  /// close-out. Shopify sends no webhook at all while a challenge is open, so
  /// the order looks settled from here and close-out is the exit a merchant
  /// reaches for — then the member authenticates weeks later and the charge goes
  /// through. The contract was cancelled, so nothing *we* did asked for it.
  ///
  /// Advisory (`blocksProcessing: false`): there is no processing left to hold.
  /// The order has a Shopify order and a write-off, and what it needs is the
  /// money returned, not re-entry into contract generation or billing.
  ///
  /// Note this cause does **not** reach Highlighted Issues, which excludes
  /// closed-out orders on purpose — close-out is meant to be the end of an
  /// order. It is read on the order's own page.
  CHARGED_AFTER_CLOSE_OUT
  COMPLIANCE_CHECK_FAILED
  /// We tried to ask the Compliance service and could not reach it, so no check
  /// ran and no fee was calculated. Distinct from a failure: the order is not
  /// known to be non-compliant, we simply have no answer. Advisory for the same
  /// reason, and the state `complianceCheckValid: null` records on the row.
  ///
  /// **Only a failed attempt.** `getComplianceCheck` returns `skippedNoApp`,
  /// `skippedNoProducts` and `skippedNoDob` when a check was never appropriate —
  /// the merchant has no Compliance app, nothing in the order ships, or there is
  /// no date of birth on file. None of those raise this, because nothing is
  /// wrong: most orders on most shops legitimately have no compliance check.
  ///
  /// This is the state that used to be invisible — the Highlighted Issues query
  /// matched only `complianceCheckValid: false`, so 15 production orders left
  /// unchecked by a 2026-09 outage never appeared anywhere.
  COMPLIANCE_CHECK_UNAVAILABLE
  /// Backfilled onto rows flagged before issues existed, where the cause cannot
  /// be recovered. Renders as today's generic "Pre-processing checks failed".
  LEGACY_UNKNOWN
}

enum ReleaseOrderIssueResolvedBy {
  /// The cause was no longer detected when the order was re-resolved.
  SYSTEM
  /// A merchant action cleared it.
  MERCHANT
}

model ReleaseOrderProduct {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  order            ReleaseOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  releaseProduct   ReleaseProduct @relation(fields: [releaseProductId], references: [id], onDelete: Cascade)
  releaseProductId String
  price            Float          @default(0) // price at the time of release order creation/update
  currencyCode     String         @default("USD")
  quantity         Int
}

model ClubCustomer {
  id                             String   @id @default(cuid())
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  platformCustomerId             String
  defaultPlatformPaymentMethodId String? // eg the default payment method ID in Shopify
  shop                           String
  defaultEmail                   String
  firstName                      String?
  lastName                       String?
  defaultPhoneNumber             String?
  defaultShippingAddress         Json?
  defaultBillingAddress          Json?
  notes                          String?

  ReleaseOrder       ReleaseOrder[]
  Membership         Membership[]
  UsageBillingRecord UsageBillingRecord[]

  @@unique([platformCustomerId, shop])
  /// Members table: scoped to the shop and ordered by name, with `id` as the
  /// cursor's tiebreaker. The unique above leads on `platformCustomerId`, so it
  /// cannot serve a `shop = ?` lookup — without this the list sorts by
  /// sequential scan, which is what CSC-824 is about avoiding at scale.
  @@index([shop, firstName, lastName, id])
}

// Some defaults exist on the customer but having this per-membership allows for different addresses etc per club, necessary for some use cases
model Membership {
  id                                 String                    @id @default(cuid())
  createdAt                          DateTime                  @default(now())
  updatedAt                          DateTime                  @updatedAt
  platformContractId                 String? // eg the subscription contract ID in Shopify
  platformPaymentMethodId            String? // eg the payment method ID in Shopify
  // Cached card-expiry data for the CARD_EXPIRING_SOON email, so the daily cron
  // can pre-filter in SQL instead of querying Shopify for every active member.
  // Always describes the current `platformPaymentMethodId`: populated/verified
  // lazily by the cron and invalidated (cleared) when the payment method changes
  // or is revoked. `cardExpiresAt` is the end of the card's expiry month;
  // `cardCheckedAt` is the last Shopify verification.
  cardExpiresAt                      DateTime?
  cardCheckedAt                      DateTime?
  email                              String?
  phoneNumber                        String?
  shippingAddress                    Json?
  billingAddress                     Json?
  preferredShippingRateCode          String? // eg the shipping rate ID in Shopify
  preferredDeliveryMethod            DeliveryMethod?
  preferredLocalDeliveryInstructions String? // special instructions for local delivery
  preferredPickupPlatformLocationId  String? // if pickup, which location ID
  memberNumber                       String? // human-readable membership ID fixed at creation (e.g., "RC-001")
  externalMemberNumber               String? // preserved member number from migration/external system
  // Which code path created this membership. Written on create ONLY — deliberately
  // absent from the update branch of `upsertClubCustomerMembership`, because this
  // records how the membership *originated*: a member who leaves and rejoins through
  // a different pathway keeps their original value. Null means the row predates this
  // column (no backfill was attempted).
  signupSource                       MembershipSignupSource?
  customer                           ClubCustomer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId                         String
  club                               Club                      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId                             String
  joinedAt                           DateTime                  @default(now())
  leftAt                             DateTime?
  pausedAt                           DateTime?
  pauseReleasesForCount              Int?
  pauseUntil                         DateTime?
  status                             MembershipStatus          @default(ACTIVE)
  nextMembershipBillingDate          DateTime? // when this member should next be billed for membership fee
  lastMembershipBilledAt             DateTime? // when they were last successfully billed for membership fee
  events                             MembershipEvent[] // related to Release type clubs
  billingRecords                     MembershipBillingRecord[]
  bundleSubscription                 BundleSubscription?
  bundleSubscriptionEvents           BundleSubscriptionEvent[]

  @@unique([customerId, clubId]) // prevent duplicates
  @@unique([clubId, memberNumber]) // enforce unique member numbers per club
  @@index([customerId])
  @@index([clubId])
  @@index([customerId, status])
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  LEFT
  PENDING_MIGRATION
}

/// How a membership was created. See documentation/plans/signup-pathway-parity.md.
///
/// POS covers both POS flows: the paid one arrives via `subscription_contracts/create`
/// like a web checkout and is told apart by the `_crushsuite_signup_source` line-item
/// property on the origin order, not by which handler ran.
enum MembershipSignupSource {
  CHECKOUT // theme PDP → Shopify checkout
  POS // POS extension, paid or card-less
  ADMIN // admin dashboard "Add Member" modal
  ADMIN_DRAFT_ORDER // deprecated draft-order route (still reachable)
  MIGRATION // CSV member import
  BUNDLE_CHECKOUT // bundle subscription PDP → checkout
}

model MembershipBillingRecord {
  id                       String                  @id @default(cuid())
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  membership               Membership              @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId             String
  billingCycleStart        DateTime // start of the period being billed
  billingCycleEnd          DateTime // end of the period being billed
  amount                   Float // amount charged
  currencyCode             String                  @default("USD")
  status                   MembershipBillingStatus @default(PENDING)
  platformOrderId          String? // Shopify order ID on success
  platformBillingAttemptId String? // Shopify billing attempt ID
  errorMessage             String? // error details on failure
  attemptCount             Int                     @default(1) // retry tracking
  processedAt              DateTime? // when the attempt resolved

  @@index([membershipId])
  @@index([status])
  @@index([membershipId, status])
}

enum MembershipBillingStatus {
  PENDING
  SUCCESS
  FAILED
  CHALLENGED
}

model MembershipEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId String

  type     MembershipEventType
  reason   String?
  metadata Json?

  effectiveFrom            DateTime  @default(now())
  effectiveForReleaseCount Int?
  effectiveUntil           DateTime?
}

enum MembershipEventType {
  JOINED
  PAUSED
  UNPAUSED
  LEFT
  REJOINED
  SKIPPED_RELEASE
  UNSKIPPED_RELEASE
  /// A merchant wrote off the member's order for one release: it will never
  /// ship and never bill. Distinct from SKIPPED_RELEASE, which records the
  /// *member* choosing to skip — putting a merchant's decision under that type
  /// would tell the member they did something they did not do.
  RELEASE_ORDER_CLOSED_OUT
  /// A merchant set up the member's order for one release from the dashboard
  /// ("Initialize to edit"), ahead of or instead of bulk creation. Recorded so a
  /// merchant-initialised order is never inferred from timestamps or notes.
  RELEASE_ORDER_INITIALIZED
  CUSTOMIZED
  ORDER_PLACED
  ADDRESS_CHANGED
  PAYMENT_METHOD_CHANGED
  MEMBERSHIP_BILLED
  BILLING_FAILED
}

// ─── Bundle Subscription ──────────────────────────────────────────

enum BundleMode {
  FIXED // merchant pre-selects products
  PICK_AND_MIX // customer chooses from catalog
  MIGRATED // catch-all per-club marker for migrated subscribers whose configs don't match any merchant-curated FIXED/PICK_AND_MIX type. Per-customer data lives entirely on BundleSubscription + BundleSelectionSnapshot. See documentation/reference/bundle-subscriptions/migration.md.
}

enum BundleTypeStatus {
  active // visible on storefront, accepts new signups
  archived // hidden from storefront, no new signups, existing subscribers unaffected
}

enum BundleFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  BIANNUALLY
  ANNUALLY
}

enum BundleSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum BundleOrderStatus {
  PENDING // created, awaiting billing cycle
  PROCESSING // billing attempt in progress
  COMPLETED // order created successfully
  FAILED // billing failed
  SKIPPED // customer skipped this cycle
  CHALLENGED // 3D Secure challenge from financial institution
  ORDER_ID_UNRESOLVED // billing succeeded but the resulting order ID could not be confirmed
}

/// Where a BundleOrder originated from. Drives billing-CRON behaviour
/// (CHECKOUT rows are already-billed and must be skipped) and merchant
/// reporting.
enum BundleOrderSource {
  CHECKOUT // first order from the customer's signup checkout (already billed by Shopify)
  RENEWAL // recurring billing-attempt-driven order from the CRON
  MANUAL // future: merchant-created from the dashboard (e.g. retry, replacement)
}

/// Defines a bundle offering within a club.
/// For FIXED mode: each BundleType is a tier/variant (e.g., "3-Pack Red", "6-Pack Mixed")
/// For PICK_AND_MIX mode: each BundleType is a curated option (e.g., "Build Your Red 6-Pack")
model BundleType {
  id                         String               @id @default(cuid())
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  name                       String // "Red Wine 6-Pack", "Mixed Case", "3-Pack Sampler"
  description                String? // customer-facing description shown during selection
  mode                       BundleMode // FIXED or PICK_AND_MIX
  status                     BundleTypeStatus     @default(active) // archived = no new signups, hidden from storefront; existing subscribers continue
  minItems                   Int                  @default(1)
  maxItems                   Int
  platformSellingPlanGroupId String? // Shopify selling plan for this bundle type
  platformProductId          String? // Shopify product that represents this bundle type on PDP
  platformVariantId          String?
  orderPriority              Int                  @default(0) // display order in the BundleType selection step
  clubId                     String
  club                       Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  products                   BundleProduct[]
  subscriptions              BundleSubscription[]
  discounts                  BundleDiscount[]

  @@index([clubId])
}

/// Products available in a bundle type (merchant catalog for this bundle)
model BundleProduct {
  id                  String               @id @default(cuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  platformProductId   String
  platformVariantId   String
  defaultQuantity     Int                  @default(0) // for FIXED bundles, this is the set quantity
  minQuantity         Int? // null = no minimum
  maxQuantity         Int? // null = no maximum
  price               Float                @default(0) // price shown for this product in the bundle
  priceAtCreation     Float                @default(0) // original price for compareAt
  currencyCode        String               @default("USD")
  excludeFromDiscount Boolean              @default(false)
  kind                ProductKind // default = included, optional = customer can add/remove
  orderPriority       Int                  @default(0)
  bundleTypeId        String
  bundleType          BundleType           @relation(fields: [bundleTypeId], references: [id], onDelete: Cascade)
  BundleOrderProduct  BundleOrderProduct[]

  @@index([bundleTypeId])
}

/// A customer's active bundle subscription (1:1 with Membership for bundle clubs)
model BundleSubscription {
  id                             String                   @id @default(cuid())
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  frequency                      BundleFrequency          @default(MONTHLY)
  status                         BundleSubscriptionStatus @default(ACTIVE)
  platformConsolidatedContractId String? // the FINAL consolidated Shopify contract
  nextBillingDate                DateTime?
  lastBilledAt                   DateTime?
  membershipId                   String                   @unique
  membership                     Membership               @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  bundleTypeId                   String
  bundleType                     BundleType               @relation(fields: [bundleTypeId], references: [id], onDelete: Cascade)
  orders                         BundleOrder[]
  currentSelections              BundleSelectionSnapshot?

  /// Cart-side bundle UUID (`_cs_bundle_id` from the parent cart line),
  /// generated once per cart-add by the bundle builder JS. Used as the
  /// idempotency key for `handleBundleSignup` — duplicate webhooks for
  /// the same checkout no-op instead of creating a second consolidated
  /// contract. Nullable for legacy rows; new rows always set it.
  cartBundleId String? @unique

  /// Snapshot of the matched discount tier at signup (refreshed when the
  /// customer changes selections via Customer Accounts). Shape conforms
  /// to `AppliedTierSnapshot` in BundleSubscription.types.ts — the type
  /// is the source of truth and reads/writes go through helpers, not raw
  /// Json. Null if no tier was matched.
  appliedTier Json?

  /// Total $ product discount baked into the contract for one billing
  /// cycle, summed across all line-level adjustments. Mirrors the contract
  /// state for fast queries without re-reading from Shopify.
  productDiscountTotal Float?

  // ─── Locked-in delivery at signup (refreshed on customer changes) ──
  /// Delivery method chosen at checkout. Mirrors ReleaseOrder.deliveryMethod.
  /// Determines which of the per-method blocks below carry data:
  ///   SHIPPING       → deliveryAddress + shippingRate/RateTitle/...
  ///   PICKUP         → deliveryPickup* fields, no deliveryAddress
  ///   LOCAL_DELIVERY → deliveryAddress + deliveryLocalDelivery* fields
  deliveryMethod  DeliveryMethod @default(SHIPPING)
  /// Address used for SHIPPING and LOCAL_DELIVERY methods. Null for PICKUP.
  /// Shape mirrors the address used by Membership/ReleaseOrder.
  deliveryAddress Json?
  /// Phone number for delivery notifications.
  deliveryPhone   String?

  // SHIPPING-specific
  /// Carrier code (e.g., "shopify-Standard", "03:U61302558" for UPS Access Point).
  shippingRate            String?
  /// Display title of the shipping rate (e.g., "Standard Shipping",
  /// "📦 UPS Pickup: 3519 NE 15TH AVE").
  shippingRateTitle       String?
  /// Pre-discount carrier rate.
  shippingBasePrice       Float?
  /// Post-discount price billed each cycle (= contract.deliveryPrice for SHIPPING).
  shippingDiscountedPrice Float?
  /// Title of the shipping discount, if one was applied. Null when no
  /// shipping discount applied.
  shippingDiscountTitle   String?

  // PICKUP-specific
  deliveryPickupPlatformLocationId String?
  deliveryPickupTitle              String?
  deliveryPickupDescription        String?
  deliveryPickupCode               String?

  // LOCAL_DELIVERY-specific
  deliveryLocalDeliveryCode         String?
  deliveryLocalDeliveryInstructions String?

  /// Compliance fee variants baked into the consolidated contract for
  /// each billing cycle. Mirrors `ReleaseOrder.complianceFee` shape:
  /// `{ [variantId: string]: quantity, complianceKey?: string }`.
  /// Refreshed on signup, selections changes, address changes, phone
  /// changes, and bundleType swaps. Driven entirely from the Compliance
  /// app's per-state rules — no value here means the customer ships to
  /// a state with no compliance fee, OR the merchant hasn't enabled
  /// `Club.addComplianceProducts`, OR the Compliance app is not
  /// installed. Null is interchangeable with empty / absent.
  complianceFee     Json?
  /// Dollar total of the compliance fee for one cycle. Per-unit price
  /// is derived as `complianceFeeCost / totalQty(complianceFee)` when
  /// composing contract line items.
  complianceFeeCost Float @default(0)

  @@index([membershipId])
  @@index([bundleTypeId])
  @@index([status, nextBillingDate])
}

/// Snapshot of the product selections currently baked into the
/// consolidated subscription contract. Created at signup for ALL
/// bundle modes — for PICK_AND_MIX it captures the customer's picks,
/// for FIXED it captures the BundleType's default products at signup
/// time so a later merchant edit doesn't retroactively change what
/// the customer is billed for. Re-upserted on every selections /
/// bundleType update so it stays in sync with the live contract.
/// Used by `verifyContractMatchesSubscription` (9h) as the source of
/// truth for pre-billing line drift detection.
model BundleSelectionSnapshot {
  id                   String             @id @default(cuid())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  bundleSubscriptionId String             @unique
  bundleSubscription   BundleSubscription @relation(fields: [bundleSubscriptionId], references: [id], onDelete: Cascade)
  selections           Json // [{productId, variantId, quantity}]
}

/// A specific billing cycle order for a bundle subscription. The CHECKOUT
/// row captures the customer's first order (already billed by Shopify);
/// RENEWAL rows are created by the billing CRON; MANUAL is reserved for
/// future merchant-driven creation.
model BundleOrder {
  id                       String             @id @default(cuid())
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  bundleSubscriptionId     String
  bundleSubscription       BundleSubscription @relation(fields: [bundleSubscriptionId], references: [id], onDelete: Cascade)
  source                   BundleOrderSource  @default(RENEWAL)
  billingCycleStart        DateTime
  billingCycleEnd          DateTime
  status                   BundleOrderStatus  @default(PENDING)
  platformContractId       String? // consolidated contract used for billing
  platformOrderId          String? // Shopify order created on success
  platformBillingAttemptId String?
  subtotal                 Float              @default(0)
  productDiscountTotal     Float              @default(0)
  shippingCost             Float              @default(0) // post-discount, billed
  shippingBasePrice        Float? // pre-discount carrier rate
  shippingDiscountTotal    Float              @default(0) // shippingBasePrice - shippingCost
  shippingDiscountTitle    String?
  /// Per-cycle snapshot of the compliance fee variants billed by THIS
  /// order (mirrors `BundleSubscription.complianceFee` at billing
  /// time). Same `{ [variantId]: qty, complianceKey? }` shape.
  complianceFee            Json?
  /// Dollar total of the compliance fee for this cycle (snapshot of
  /// `BundleSubscription.complianceFeeCost` at billing time).
  complianceFeeCost        Float              @default(0)
  /// Result of the per-cycle prepurchase compliance check. `true` =
  /// passed, `false` = failed (errors pushed to `notes`, billing still
  /// proceeded), `null` = check skipped (no DOB on file, Compliance app
  /// not installed, or no shipping address). Runs whether or not
  /// `Club.addComplianceProducts` is on — that setting governs the fee only.
  complianceCheckValid     Boolean?
  total                    Float              @default(0)
  currencyCode             String             @default("USD")
  skippedAt                DateTime?
  errorMessage             String?
  /// Non-fatal notes attached during the billing cycle — e.g. the
  /// preferred shipping rate not being available so a fallback was
  /// billed, or a shipping recompute that failed and used last-
  /// known-good. Mirrors `ReleaseOrder.notes`. Use `errorMessage`
  /// for dispositive failures (status = FAILED), `notes` for
  /// informational items the merchant should see but that didn't
  /// block billing.
  notes                    String[]           @default([])

  // ─── Per-cycle delivery snapshot ────────────────────────────────────
  /// Per-cycle copy of the subscription's delivery method. The
  /// subscription's locked-in method may change over time (customer
  /// switches from shipping to pickup); this row records what was
  /// actually used for THIS order. Same enum + per-method blocks as
  /// BundleSubscription.
  deliveryMethod  DeliveryMethod @default(SHIPPING)
  deliveryAddress Json?
  deliveryPhone   String?

  // SHIPPING-specific
  shippingRate      String?
  shippingRateTitle String?

  // PICKUP-specific
  deliveryPickupPlatformLocationId String?
  deliveryPickupTitle              String?
  deliveryPickupDescription        String?
  deliveryPickupCode               String?

  // LOCAL_DELIVERY-specific
  deliveryLocalDeliveryCode         String?
  deliveryLocalDeliveryInstructions String?

  /// Snapshot of the matched discount tier at the time this order ran.
  /// Same `AppliedTierSnapshot` shape as BundleSubscription.appliedTier.
  appliedTier Json?

  products BundleOrderProduct[]

  @@index([bundleSubscriptionId])
  @@index([status, billingCycleStart])
  @@index([source])
}

/// Products in a specific bundle order
model BundleOrderProduct {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  bundleOrderId   String
  bundleOrder     BundleOrder   @relation(fields: [bundleOrderId], references: [id], onDelete: Cascade)
  bundleProductId String
  bundleProduct   BundleProduct @relation(fields: [bundleProductId], references: [id], onDelete: Cascade)
  quantity        Int
  price           Float         @default(0)
  currencyCode    String        @default("USD")

  @@index([bundleOrderId])
}

/// Discounts for a bundle type — reuses existing discount enum pattern
model BundleDiscount {
  id           String     @id @default(cuid())
  bundleTypeId String
  bundleType   BundleType @relation(fields: [bundleTypeId], references: [id], onDelete: Cascade)

  name        String
  description String?

  scope       DiscountScope // PRODUCT | SHIPPING
  condition   DiscountCondition // QUANTITY | SUBTOTAL
  frequency   BundleFrequency? // if set, discount only applies at this frequency tier
  minQuantity Int?
  minSubtotal Float?

  valueType       DiscountValueType // PERCENT | FIXED
  discountPercent Float?
  discountAmount  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bundleTypeId])
}

/// Audit log of customer-initiated bundle subscription actions
/// (reschedule, skip, frequency change, etc.). Hangs off Membership
/// so a customer's bundle audit trail lives alongside their existing
/// MembershipEvent history (single per-customer-club audit trail).
/// Per-event metadata (e.g. `{ previousNextBillingDate,
/// newNextBillingDate, source }`) lives in `metadata` Json so each
/// event type can carry its own shape without schema churn.
model BundleSubscriptionEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId String

  type     BundleSubscriptionEventType
  reason   String?
  metadata Json?

  @@index([membershipId, createdAt])
}

enum BundleSubscriptionEventType {
  RESCHEDULED
  SKIPPED
  FREQUENCY_CHANGED
  SELECTIONS_CHANGED
  BUNDLE_TYPE_CHANGED
  ADDRESS_CHANGED
  PHONE_CHANGED
  PAYMENT_CHANGED
}

enum ClubTz {
  // Americas
  America_St_Johns
  America_Halifax
  America_Toronto
  America_Winnipeg
  America_Edmonton
  America_Vancouver
  America_Whitehorse
  America_Anchorage
  Pacific_Honolulu
  America_New_York
  America_Chicago
  America_Denver
  America_Los_Angeles
  America_Sao_Paulo
  America_Argentina_Buenos_Aires
  America_Lima
  America_Bogota
  America_Mexico_City
  America_Caracas
  America_Santiago
  America_Montevideo
  America_La_Paz
  America_Puerto_Rico
}

enum Status {
  INSTALLED
  READY
  REMOVED
  ERROR
  MODULE_APP_INSTALLED
}

enum BillingType {
  monthly
  percentage
  oneTime
}

model MerchantEmailLog {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  shop      String
  emailType MerchantEmailType
  dedupKey  String
  sentTo    String
  success   Boolean           @default(true)
  /// Set on failed sends: false = permanent (4xx) — do not re-attempt on CRON.
  /// null on successful sends.
  retryable Boolean?
  error     String?
  metadata  Json?

  @@unique([shop, emailType, dedupKey])
  @@index([shop])
  @@map("MerchantEmailLog")
}

enum MerchantEmailType {
  WELCOME
  CUSTOMIZATION_OPENING
  CUSTOMIZATION_CLOSING
  CUSTOMIZATION_CLOSED
  RELEASE_CLOSING
  RELEASE_SUMMARY
  MEMBER_JOINED
  MEMBER_CANCELLED
  PAYMENT_FAILED_ALERT
  RECONNECT_STORE
}

enum AfterMaxRetriesAction {
  PAUSE
  CANCEL
}

// ─── Customer Email ─────────────────────────────────────────────────

enum CustomerEmailType {
  MEMBER_WELCOME
  MEMBERSHIP_PAUSED
  MEMBERSHIP_RESUMED
  MEMBERSHIP_CANCELLED
  CUSTOMIZATION_OPEN
  CUSTOMIZATION_REMINDER_72HR
  CUSTOMIZATION_REMINDER_24HR
  CUSTOMIZATION_CONFIRMED
  ORDER_PROCESSING_NOTICE
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  CARD_EXPIRING_SOON
  POS_ADD_PAYMENT
}

/// One row per (shop, emailType, dedupKey). `createdAt` is the FIRST send;
/// `lastSentAt` / `sendCount` track repeats for the resendable types (see
/// RESENDABLE_EMAIL_COOLDOWNS in CustomerEmail.model.ts). Once-only types never
/// increment past 1.
model CustomerEmailLog {
  id         String            @id @default(cuid())
  createdAt  DateTime          @default(now())
  lastSentAt DateTime          @default(now())
  sendCount  Int               @default(1)
  shop       String
  emailType  CustomerEmailType
  dedupKey   String
  sentTo     String
  success    Boolean           @default(true)
  /// Set on failed sends: false = permanent (4xx) — CRON must not re-mail forever.
  /// null on successful sends. Transient failures stay retryable: true.
  retryable  Boolean?
  error      String?
  metadata   Json?

  @@unique([shop, emailType, dedupKey])
  @@index([shop])
}

// ─── Merchant Settings ──────────────────────────────────────────────

model MerchantEmailSettings {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shop           String   @unique
  merchantId     Int      @unique
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  supportEmail   String?
  footerText     String?

  maxRetryAttempts      Int                   @default(3)
  retryIntervalDays     Int                   @default(3)
  afterMaxRetriesAction AfterMaxRetriesAction @default(PAUSE)

  customizationReminderDays    Int     @default(7)
  customizationReminderEnabled Boolean @default(true)
  finalReminderDays            Int     @default(2)
  finalReminderEnabled         Boolean @default(true)
  cardExpiringDays             Int     @default(30)
  cardExpiringEnabled          Boolean @default(true)

  alertNewMember    Boolean @default(true)
  alertMemberCancel Boolean @default(true)
  alertPaymentFail  Boolean @default(true)
  alertReleaseShips Boolean @default(false)

  defaultShippingMethodCode String?
  defaultFlatRate           Decimal? @db.Decimal(10, 2)
  defaultFlatRateEnabled    Boolean  @default(false)
}

// ─── Club Migration ────────────────────────────────────────────────

model ClubMigration {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  clubId    String
  club      Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  shop      String
  status    MigrationStatus @default(PENDING)

  // Progress counts (updated by worker after each phase)
  totalRecords           Int @default(0)
  resolvedCount          Int @default(0)
  membershipCreatedCount Int @default(0)
  paymentResolvedCount   Int @default(0)
  contractCreatedCount   Int @default(0)
  errorCount             Int @default(0)

  // Merchant config choices
  // Opt-in: apply a card the customer already has saved in Shopify to their club
  // membership. Off by default — they may want to bill the club to a different
  // card than one already on their account (those members get an add-payment
  // email instead). CSV gateway-token transfer always wins over this.
  useExistingShopifyPaymentMethod Boolean @default(false)
  gatewayType                     String? // "stripe" | "braintree" | "authorize_net" — only if CSV has gateway tokens
  gracePeriodDays                 Int     @default(0)

  // File tracking
  filename String? // original CSV filename for display

  // Worker tracking
  workerJobId String?
  completedAt DateTime?
  error       String?

  // ─── Payment method retry ───────────────────────────────────────────
  // A merchant whose gateway connection was unfinished has every imported card
  // rejected. Once they finish connecting it the tokens are still good, so the
  // fix is to run the payment stage again — no new CSV involved.
  //
  // The lock lives here rather than relying on a deterministic BullMQ jobId:
  // completed jobs are retained, so a repeated id would silently refuse a
  // legitimate *second* retry days later. See OPEN-ITEMS row 46, which records
  // the same trap. Being in the database is also what lets the progress UI
  // survive a page reload — the lock is read from the loader, not held in
  // component state.
  /// Set while a retry is queued or running; cleared on completion or failure.
  paymentRetryJobId     String?
  /// Staleness marker, so a lock orphaned by a dead worker can be identified.
  /// Nothing reads it, so the lock above cannot expire — see issue #922.
  paymentRetryStartedAt DateTime?

  // ─── DOB sync ───────────────────────────────────────────────────────
  // Re-pushes the migration's dates of birth to the Compliance app. Phase 3
  // does this once and never fails the record over it, so any failure of that
  // step (an outage, a wrong host, the Compliance app installed later) is
  // otherwise unrecoverable. Same lock shape as the payment retry, and the
  // same trap: nothing expires it.
  /// Set while a sync is queued or running; cleared on completion or failure.
  dobSyncJobId     String?
  /// Staleness marker only.
  dobSyncStartedAt DateTime?

  // ─── Resumable pipeline ─────────────────────────────────────────────
  // The import runs as a chain of short steps, each doing one batch and
  // enqueuing the next, so a redeploy costs one batch instead of the whole
  // import. These columns are what make re-entry safe and self-limiting.
  //
  // Progress itself is NOT here: every record already carries the stage it
  // reached (`ClubMigrationRecord.status`), which is what a resumed run reads
  // to know where to pick up. See
  // documentation/plans/migration-interruption-resilience.md.

  /// `{uuid}::{timestamp}` — stops a second step running against this migration
  /// while one is live. Self-expiring by design: the timestamp is *in* the
  /// value, so a process dying between set and clear cannot wedge the import
  /// the way `paymentRetryJobId` above can. Window is minutes, not the release
  /// pipeline's two hours — a step is one batch. See `~/util/processLock`.
  processLockId String?
  /// Consecutive *failures*, reset on any step that does work. Drives the
  /// retry backoff so a migration failing for a real reason (a revoked access
  /// token, a club with no product) backs off instead of re-running forever.
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  /// Last step failure, for the dashboard and for support. Distinct from
  /// `error`, which records the terminal failure of the whole migration.
  lastError     String?

  records ClubMigrationRecord[]

  @@index([clubId])
  @@index([shop])
}

model ClubMigrationRecord {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  migrationId String
  migration   ClubMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)

  // Source data from CSV
  rowNumber               Int
  email                   String
  firstName               String?
  lastName                String?
  phone                   String?
  csvShopifyCustomerId    String?
  externalMemberNumber    String?
  joinedAt                DateTime?
  address1                String?
  address2                String?
  city                    String?
  provinceCode            String?
  countryCode             String?
  zip                     String?
  preferredDeliveryMethod DeliveryMethod?
  notes                   String?
  dateOfBirth             String? // AES-encrypted DOB (PII)
  /// When the DOB above last reached the Compliance app: `setCustomerDob`
  /// answered success, which it also does when Compliance already held one.
  /// Null alongside a `dateOfBirth` means the merchant supplied a DOB that
  /// Compliance does not have — the one state the dashboard treats as an
  /// issue. A row with no `dateOfBirth` is "not provided", never a problem.
  /// Written by Phase 3 and by the DOB sync job.
  dobSyncedAt             DateTime?
  /// Last push failure, status first (`404 Not Found: Customer not found`,
  /// `401 …`). Cleared on success.
  dobSyncError            String?
  gatewayCustomerToken    String?
  gatewayPaymentToken     String?

  // ─── Bundle migration fields (bundle-subscription clubs only) ──────
  // See documentation/reference/bundle-subscriptions/migration.md.
  /// Customer's per-line selections from the CSV: [{variantId, quantity, price}].
  /// Required (or `shopifyContractId`) for bundle-club rows.
  bundleSelections  Json?
  /// Customer's billing cadence. Validated against Club.bundleFrequencies at upload.
  bundleFrequency   BundleFrequency?
  /// Optional source contract GID. Must be owned by our app — cross-app
  /// reads are blocked by Shopify's read_own_subscription_contracts scope.
  /// When provided, the worker hydrates lines/discounts/delivery from the
  /// contract instead of reading the CSV columns.
  shopifyContractId String?
  /// Honors the customer's existing next-bill date if provided. Falls back
  /// to today + grace period.
  nextBillingDate   DateTime?

  // Product discount (used for the MIGRATED-fallback path; ignored when
  // matched to a real BundleType — merchant tier wins there)
  productDiscountName  String?
  productDiscountType  DiscountValueType? // PERCENT | FIXED
  productDiscountValue Float?

  // Locked-in shipping (SHIPPING method only)
  shippingRateCode  String?
  shippingBasePrice Float? // pre-discount carrier rate
  shippingPrice     Float? // post-discount price billed (derived from base − discount when discount columns present)

  // Shipping discount (FREE normalized to PERCENT 100 at validation time)
  shippingDiscountName  String?
  shippingDiscountType  DiscountValueType?
  shippingDiscountValue Float?

  // Resolution state (populated by worker phases)
  status                  MigrationRecordStatus @default(PENDING)
  platformCustomerId      String?
  customerResolution      CustomerResolution?
  clubCustomerId          String?
  membershipId            String?
  platformPaymentMethodId String?
  platformContractId      String?
  /// Set by Phase 5 to the BundleType GID that this row was matched to
  /// (or the per-club catch-all MIGRATED type's GID). Drives the
  /// dashboard's "matched vs migrated as-is" categorization.
  bundleTypeIdResolved    String?

  // Status flags
  paymentMethodExists Boolean @default(false)

  /// Tracks the add-payment email sent to a member who has no payment method
  /// after import, so they can add a card in the Customer Accounts extension.
  paymentEmailSent      Boolean   @default(false)
  paymentEmailSentAt    DateTime?
  paymentEmailSendCount Int       @default(0)
  contractCreated       Boolean   @default(false)

  // ─── Payment method verification ───────────────────────────────────
  // `customerPaymentMethodRemoteCreate` returns a placeholder synchronously and
  // validates against the gateway *afterwards*, so `platformPaymentMethodId`
  // alone proves nothing — a rejected card and a good one look identical at the
  // moment Phase 4 records them. These columns hold the outcome once it is
  // known. See documentation/plans/migration-payment-method-verification.md.

  /// Null for records that never imported a remote card (no gateway token, or an
  /// existing Shopify card, which is vaulted already and needs no verification).
  paymentVerificationState PaymentVerificationState?
  paymentVerifiedAt        DateTime?
  paymentVerifyAttempts    Int                       @default(0)
  /// Shopify's payment instrument type — `CustomerRemoteCreditCard` is an
  /// unvaulted placeholder, `CustomerCreditCard` a real card. Stored rather than
  /// inferred so the native-vs-remote distinction rests on evidence.
  paymentInstrumentType    String?
  /// A `CustomerPaymentMethodRevocationReason` value. **Not** carried by the
  /// revoke webhook — that payload is the create payload echoed back — so it is
  /// fetched from the Admin API, which needs `showRevoked: true` or it returns
  /// null for a revoked method.
  paymentRevokedReason     String?

  // Error tracking
  error      String?
  errorPhase String? // "validation" | "customer_resolve" | "membership_create" | "payment_resolve" | "contract_create"

  @@unique([migrationId, email])
  /// `[migrationId]` alone was a strict prefix of the composites below and could
  /// never be chosen over them — pure insert cost on a table written up to
  /// MAX_IMPORT_ROWS at a time. `rowNumber` is appended to the status index so
  /// the filtered tabs get their sort from the index too, not just `all`.
  @@index([migrationId, status, rowNumber])
  /// The detail table's default order, for the unfiltered tab. See CSC-826.
  @@index([migrationId, rowNumber])
  @@index([platformCustomerId])
  // Member detail resolves migration deep-links by membershipId, and a migration
  // writes one row per imported member — so a multi-thousand-member onboarding
  // makes the unindexed lookup a real seq-scan.
  @@index([membershipId])
}

enum MigrationStatus {
  PENDING
  VALIDATING
  RESOLVING_CUSTOMERS
  CREATING_MEMBERSHIPS
  RESOLVING_PAYMENTS
  COLLECTING_PAYMENTS
  COMPLETED
  FAILED
  CANCELLED
}

enum MigrationRecordStatus {
  PENDING
  CUSTOMER_RESOLVED
  MEMBERSHIP_CREATED
  PAYMENT_RESOLVED
  COMPLETED
  ERROR
  SKIPPED // existing membership found
}

enum CustomerResolution {
  EXISTING_BY_ID // found by shopify_customer_id from CSV
  EXISTING_BY_EMAIL // found via customerByIdentifier
  CREATED // new customer created via customerCreate
}

/// Outcome of Shopify's asynchronous validation of a gateway-imported payment
/// method. Deliberately a separate axis from `MigrationRecordStatus`, which
/// tracks pipeline *phase* progress — `PAYMENT_RESOLVED` keeps meaning "Phase 4
/// ran", not "the card is good".
enum PaymentVerificationState {
  PENDING // placeholder created; Shopify has not finished validating it
  VERIFIED // instrument populated — a real, usable card
  REVOKED // Shopify rejected it; see paymentRevokedReason
  UNVERIFIED // never resolved before we stopped waiting
}

// ─── GDPR ───────────────────────────────────────────────────────────

model GDPRRequest {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  shop               String
  merchantId         Int
  merchant           Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  type               String // "customer-redact", "customer-data-request", "shop-redact"
  platformCustomerId String?
  clubCustomerId     String?
  instructions       String?
  completed          Boolean   @default(false)
  completedAt        DateTime?

  @@index([shop])
  @@index([type, completed])
}

// ─── Usage Billing (merchant → us) ──────────────────────────────────

/// Ledger of the platform usage fee **we** charge merchants via Shopify's App
/// Events API — distinct from the customer charges we create on a merchant's
/// behalf. One row per fee ever owed, written by the call site at the moment it
/// enqueues (never by the job — a job that never runs must still leave evidence).
/// Doubles as the internal revenue record and as the input to the reconciliation
/// CRON. See documentation/reference/releases/stuck-releases-risks.md §4 D1.
model UsageBillingRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stable App Events key (`member-|bundle-|release-${orderId}`). Also the
  /// BullMQ jobId, and the only key that correlates back to Shopify — the App
  /// Events API returns no event ID, so Dev Dashboard logs are filtered by this.
  idempotencyKey String             @unique
  source         UsageBillingSource

  shop           String
  merchantId     Int
  merchant       Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  clubId         String?
  club           Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  clubCustomerId String?
  clubCustomer   ClubCustomer? @relation(fields: [clubCustomerId], references: [id], onDelete: SetNull)
  /// Originating record — MembershipBillingRecord.id | BundleOrder.id | ReleaseOrder.id.
  /// Deliberately untyped (polymorphic across the three sources), read with `source`.
  sourceRecordId String?

  platformOrderId String
  orderValue      Float? // order total the meter's percentage applies to
  currencyCode    String?
  reportedValue   Int? // whole-dollar value actually sent to App Events
  eventHandle     String? // meter handle, in case it ever changes

  status        UsageBillingStatus @default(PENDING)
  /// When App Events returned 202 + success:true. NOT proof of billing: a 202
  /// only means "received" — validation happens async and is visible only in the
  /// Dev Dashboard. Hence ACCEPTED, never SUCCESS.
  acceptedAt    DateTime?
  /// Shopify replied `Idempotent-Replay: true` — already on record, not re-billed.
  replayed      Boolean            @default(false)
  /// The timestamp we sent; decides which billing cycle it lands in (PERIOD_CLOSED).
  sentTimestamp DateTime?
  attemptCount  Int                @default(0)
  lastError     String?

  @@index([shop, createdAt])
  @@index([status, createdAt])
  @@index([clubId])
  @@index([platformOrderId])
}

enum UsageBillingSource {
  MEMBER
  BUNDLE
  RELEASE
}

enum UsageBillingStatus {
  /// Owed, not yet accepted by App Events. Reconciliation re-fires.
  PENDING
  /// 202 + success:true. The strongest claim the API supports.
  ACCEPTED
  /// Correctly nothing owed ($0 order — App Events rejects value:0). Never re-fired.
  SKIPPED
  /// Transient or credential failure. Reconciliation re-fires.
  FAILED
  /// Permanently refused (400/403, or 202 success:false). Needs a human, never re-fired.
  REJECTED
}

// ─── Release Reprocess Audit ────────────────────────────────────────

/// One row per merchant invocation of "Reprocess release", which re-drives a
/// stalled stage — including firing subscription billing attempts against
/// members' saved cards. The durable forensic record behind a disputed charge,
/// and what lets the banner survive a page refresh mid-run.
///
/// `triggeredBy` is shop-level, not per-user: it derives from
/// `session.onlineAccessInfo.associated_user`, but the app does not enable
/// online tokens, so it always falls back to the shop domain.
/// See documentation/reference/releases/manual-reprocess.md §Audit.
model ReleaseReprocessLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  releaseId   String
  release     Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  shop        String
  /// orders_not_created | contracts_not_generated | billing_not_attempted
  stage       String
  triggeredBy String
  jobId       String?

  @@index([releaseId, createdAt])
}

// ─── Feature Flags ──────────────────────────────────────────────────

model FeatureFlag {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
}
