{
  "name": "crush-suite-admin",
  "version": "1.0.0",
  "author": {
    "name": "Will Christenson",
    "email": "william.christenson@gmail.com"
  },
  "private": true,
  "scripts": {
    "predev": "npm run prisma:generate:all",
    "dev": "next dev -p 3006",
    "prebuild": "npm run prisma:generate:all",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate --schema=prisma/compliance/schema.prisma",
    "prisma:generate:clubs": "prisma generate --schema=prisma/clubs/schema.prisma",
    "prisma:generate:seats": "prisma generate --schema=prisma/seats/schema.prisma",
    "prisma:generate:all": "npm run prisma:generate && npm run prisma:generate:clubs && npm run prisma:generate:seats",
    "prisma:migrate:compliance": "prisma migrate dev --schema=prisma/compliance/schema.prisma",
    "prisma:migrate:clubs": "prisma migrate dev --schema=prisma/clubs/schema.prisma",
    "prisma:migrate:seats": "prisma migrate dev --schema=prisma/seats/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/compliance/schema.prisma",
    "prisma:studio:clubs": "prisma studio --schema=prisma/clubs/schema.prisma",
    "prisma:studio:seats": "prisma studio --schema=prisma/seats/schema.prisma",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-form": "^0.1.8",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/themes": "^3.3.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "modern-css-reset": "^1.4.0",
    "next": "^14.2.4",
    "next-auth": "^4.24.7",
    "pg": "^8.20.0",
    "prettier": "^3.8.1",
    "react": "^18",
    "react-dom": "^18",
    "react-simple-maps": "^3.0.0"
  },
  "devDependencies": {
    "@prisma/nextjs-monorepo-workaround-plugin": "^5.15.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "schema": "./prisma/compliance/schema.prisma"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true,
    "unrs-resolver@1.11.1": true
  }
}
